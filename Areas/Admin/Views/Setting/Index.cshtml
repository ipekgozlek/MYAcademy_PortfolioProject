@model MYAcademy_PortfolioProject.Entities.Contact
@{
    ViewData["Title"] = "Settings";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";
}

<!-- ===== 1) AYARLAR FORMU ===== -->
<div class="form-card">
    <form asp-area="Admin" asp-controller="Setting" asp-action="Index" method="post">
        <input type="hidden" asp-for="ContactId" />

        <div class="form-card-header">
            <div class="form-card-icon"><i class="bi bi-gear"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Settings</h5>
                <small class="text-secondary">Contact details and social links used across the website.</small>
            </div>
        </div>

        <div class="form-card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-share me-2"></i>Social Links</h6>
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label asp-for="Github" class="form-label"><i class="bi bi-github me-1"></i> GitHub</label>
                    <input asp-for="Github" class="form-control" placeholder="github.com/ipekgozlek" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Linkedin" class="form-label"><i class="bi bi-linkedin me-1"></i> LinkedIn</label>
                    <input asp-for="Linkedin" class="form-control" placeholder="linkedin.com/in/ipekgozlek" />
                </div>
            </div>

            <h6 class="fw-bold mb-3"><i class="bi bi-envelope me-2"></i>Contact Info</h6>
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="ipek@example.com" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Location" class="form-label">Location</label>
                    <input asp-for="Location" class="form-control" placeholder="İstanbul, Türkiye" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Contact Section Text</label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Aşağıdaki iletişim kanalları üzerinden bana ulaşabilirsiniz..."></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="SubDescription" class="form-label">Response Time Note</label>
                    <input asp-for="SubDescription" class="form-control" placeholder="Genellikle 24 saat içinde yanıt verilir." />
                </div>
            </div>
        </div>

        <div class="form-card-footer">
            <button type="submit" class="btn btn-accent"><i class="bi bi-check2-circle me-1"></i> Save Changes</button>
        </div>
    </form>
</div>

<!-- ===== 2) CV YÜKLEME KARTI (YENİ) ===== -->
<div class="form-card mt-4">
    <div class="form-card-header">
        <div class="form-card-icon"><i class="bi bi-file-earmark-pdf"></i></div>
        <div>
            <h5 class="mb-0 fw-bold">CV / Resume</h5>
            <small class="text-secondary">Downloaded by the "Download CV" button on your website. PDF only, max 5 MB.</small>
        </div>
    </div>

    <div class="form-card-body">
        @if (!string.IsNullOrEmpty(Model.CvFilePath))
        {
            <div class="status-box mb-4">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-file-earmark-pdf-fill fs-3" style="color:#c0342b;"></i>
                    <div>
                        <div class="fw-semibold" style="font-size:.86rem;">Current CV is active</div>
                        <small class="text-secondary">Uploading a new file will replace it.</small>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="@Model.CvFilePath" target="_blank" class="icon-btn" title="View"><i class="bi bi-eye"></i></a>
                    <a asp-area="Admin" asp-controller="Setting" asp-action="DeleteCv" class="icon-btn danger js-delete-cv" title="Remove">
                        <i class="bi bi-trash3"></i>
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning small py-2">No CV uploaded yet. The "CV İndir" button is hidden on the website.</div>
        }

        <form asp-area="Admin" asp-controller="Setting" asp-action="UploadCv" method="post" enctype="multipart/form-data"
              class="d-flex gap-2 flex-wrap">
            <input type="file" name="cvFile" accept=".pdf,application/pdf" class="form-control" style="max-width:420px;" required />
            <button type="submit" class="btn btn-accent"><i class="bi bi-upload me-1"></i> Upload CV</button>
        </form>
    </div>
</div>

<!-- ===== 3) SCRIPTLER ===== -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
<script>
    // CV silme onayı
    document.querySelectorAll('.js-delete-cv').forEach(a => a.addEventListener('click', e => {
        e.preventDefault();
        Swal.fire({
            title: 'Remove your CV?', text: 'The download button will be hidden on the website.', icon: 'warning',
            showCancelButton: true, confirmButtonText: 'Yes, remove', cancelButtonText: 'Cancel',
            confirmButtonColor: '#c0342b', cancelButtonColor: '#94a3b8', reverseButtons: true
        }).then(r => { if (r.isConfirmed) location.href = a.href; });
    }));

    // Başarı ve hata bildirimleri
    const success = @Json.Serialize(TempData["Success"]);
    const error = @Json.Serialize(TempData["Error"]);
    if (success) Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: success, showConfirmButton: false, timer: 2500 });
    if (error) Swal.fire({ icon: 'error', title: 'Upload failed', text: error, confirmButtonColor: '#8276D9' });
</script>