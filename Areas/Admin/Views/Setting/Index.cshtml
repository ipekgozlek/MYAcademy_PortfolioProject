@model MYAcademy_PortfolioProject.Entities.Contact
@{
    ViewData["Title"] = "Settings";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="form-card">
    <form asp-area="Admin" asp-controller="Setting" asp-action="Index" method="post">
        <input type="hidden" asp-for="ContactId" />

        <div class="form-card-header">
            <div class="form-card-icon"><i class="bi bi-gear"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Settings</h5>
                <small class="text-secondary">Contact details and social links used across the website.</small>
            </div>
        </div>

        <div class="form-card-body">
            <h6 class="fw-bold mb-3"><i class="bi bi-share me-2"></i>Social Links</h6>
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <label asp-for="Github" class="form-label"><i class="bi bi-github me-1"></i> GitHub</label>
                    <input asp-for="Github" class="form-control" placeholder="github.com/ipekgozlek" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Linkedin" class="form-label"><i class="bi bi-linkedin me-1"></i> LinkedIn</label>
                    <input asp-for="Linkedin" class="form-control" placeholder="linkedin.com/in/ipekgozlek" />
                </div>
            </div>

            <h6 class="fw-bold mb-3"><i class="bi bi-envelope me-2"></i>Contact Info</h6>
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="ipek@example.com" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Location" class="form-label">Location</label>
                    <input asp-for="Location" class="form-control" placeholder="İstanbul, Türkiye" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Contact Section Text</label>
                    <textarea asp-for="Description" class="form-control" rows="3"
                              placeholder="Aşağıdaki iletişim kanalları üzerinden bana ulaşabilirsiniz..."></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="SubDescription" class="form-label">Response Time Note</label>
                    <input asp-for="SubDescription" class="form-control" placeholder="Genellikle 24 saat içinde yanıt verilir." />
                </div>
            </div>
        </div>

        <div class="form-card-footer">
            <button type="submit" class="btn btn-accent"><i class="bi bi-check2-circle me-1"></i> Save Changes</button>
        </div>
    </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
<script>
    const flash = @Json.Serialize(TempData["Success"]);
    if (flash) Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: flash, showConfirmButton: false, timer: 2500 });
</script>