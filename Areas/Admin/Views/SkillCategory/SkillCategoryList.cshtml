@model List<MYAcademy_PortfolioProject.Entities.SkillCategory>
@{
    ViewData["Title"] = "Skill Categories";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="list-card">
    <div class="list-card-header">
        <div class="d-flex align-items-center gap-3">
            <div class="list-card-icon"><i class="bi bi-grid-3x3-gap"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Skill Categories</h5>
                <small class="text-secondary">Each category is a card on the website.</small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Admin" asp-controller="Skill" asp-action="SkillList" class="btn btn-soft">
                <i class="bi bi-code-slash me-1"></i> Skills
            </a>
            <a asp-area="Admin" asp-controller="SkillCategory" asp-action="CreateSkillCategory" class="btn btn-accent">
                <i class="bi bi-plus-lg me-1"></i> New Category
            </a>
        </div>
    </div>

    <table class="list-table">
        <thead>
            <tr>
                <th>Category</th>
                <th>Description</th>
                <th>Skills</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <div class="list-card-icon" style="width:36px;height:36px;font-size:1rem;"><i class="bi @item.Icon"></i></div>
                            <span class="cell-title">@item.Title</span>
                        </div>
                    </td>
                    <td class="cell-sub" style="max-width:320px;">@item.Description</td>
                    <td><span class="date-chip">@item.Skills.Count skills</span></td>
                    <td class="text-end">
                        <a asp-area="Admin" asp-controller="SkillCategory" asp-action="UpdateSkillCategory" asp-route-id="@item.SkillCategoryId"
                           class="icon-btn" title="Edit"><i class="bi bi-pencil"></i></a>
                        <a asp-area="Admin" asp-controller="SkillCategory" asp-action="DeleteSkillCategory" asp-route-id="@item.SkillCategoryId"
                           class="icon-btn danger js-delete" title="Delete"><i class="bi bi-trash3"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Any())
    {
        <div class="empty-state"><i class="bi bi-grid-3x3-gap"></i>No categories yet.</div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>
<script>
    document.querySelectorAll('.js-delete').forEach(a => a.addEventListener('click', e => {
        e.preventDefault();
        Swal.fire({
            title: 'Delete this category?',
            text: 'All skills in this category will also be deleted!',
            icon: 'warning', showCancelButton: true,
            confirmButtonText: 'Yes, delete it', cancelButtonText: 'Cancel',
            confirmButtonColor: '#c0342b', cancelButtonColor: '#94a3b8', reverseButtons: true
        }).then(r => { if (r.isConfirmed) location.href = a.href; });
    }));

    const flash = @Json.Serialize(TempData["Success"]);
    if (flash) Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: flash, showConfirmButton: false, timer: 2500 });
</script>