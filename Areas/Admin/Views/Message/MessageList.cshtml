@model List<MYAcademy_PortfolioProject.Entities.Message>

@{
    ViewData["Title"] = "Messages";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";

    var total = Model.Count;
    var unread = Model.Count(x => !x.IsRead);
    var today = Model.Count(x => x.SendDate.Date == DateTime.Today);
    var thisWeek = Model.Count(x => x.SendDate >= DateTime.Today.AddDays(-7));

    var palette = new[] { "blue", "violet", "amber", "rose", "teal", "indigo" };

    string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return (parts[0].Substring(0, 1) + (parts.Length > 1 ? parts[^1].Substring(0, 1) : "")).ToUpper();
    }
}

@section Styles {
    <style>
        .inbox {
            --brand: var(--primary-accent, #8276D9);
            --brand-hover: var(--primary-accent-hover, #6f62cf);
            --brand-soft: var(--pastel-purple, #f0eefc);
            --line: var(--border-color, #e8eaf2);
            --muted: var(--text-secondary, #64748b);
            --ink: var(--text-primary, #0f172a);
            --radius: var(--radius-lg, 16px);
            --danger: #c0342b;
            color: var(--ink);
            padding-bottom: 32px;
        }

        .inbox-head {
            margin-bottom: 24px;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 16px;
            flex-wrap: wrap;
        }

        .inbox-crumb {
            font-size: .82rem;
            color: var(--muted);
            margin-bottom: 4px;
        }

            .inbox-crumb b {
                color: var(--brand);
                font-weight: 500;
                background: var(--brand-soft);
                padding: 2px 8px;
                border-radius: 6px;
            }

        .inbox-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
            letter-spacing: -.02em;
        }

        .inbox-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 24px;
        }

        .stat {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow-subtle, none);
            padding: 20px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .stat.active {
                border-color: var(--brand);
                box-shadow: 0 8px 24px -12px rgba(130, 118, 217, .45);
            }

        .stat-label {
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--muted);
        }

        .stat.active .stat-label {
            color: var(--brand);
        }

        .stat-value {
            font-size: 1.9rem;
            font-weight: 700;
            margin: 6px 0 2px;
            letter-spacing: -.02em;
        }

        .stat-sub {
            font-size: .78rem;
            color: var(--muted);
        }

            .stat-sub.warn {
                color: #ea580c;
            }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: grid;
            place-items: center;
            font-size: 1.3rem;
            background: var(--brand-soft);
            color: var(--brand);
            flex-shrink: 0;
        }

        .stat.active .stat-icon {
            background: var(--brand);
            color: #fff;
        }

        .stat-icon.green {
            background: #ecfdf5;
            color: #059669;
        }

        .stat-icon.gray {
            background: #f1f5f9;
            color: #334155;
        }

        .inbox-card {
            background: #fff;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow-subtle, none);
            overflow: hidden;
        }

        .toolbar {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 16px 20px;
            border-bottom: 1px solid var(--line);
            flex-wrap: wrap;
        }

        .tab {
            border: 0;
            background: transparent;
            padding: 8px 14px;
            border-radius: 10px;
            font-size: .88rem;
            font-weight: 500;
            color: var(--ink);
            display: inline-flex;
            gap: 8px;
            align-items: center;
        }

            .tab .count {
                font-size: .72rem;
                background: var(--brand-soft);
                color: var(--brand);
                padding: 1px 7px;
                border-radius: 999px;
            }

            .tab.active {
                background: var(--brand);
                color: #fff;
            }

                .tab.active .count {
                    background: rgba(255, 255, 255, .25);
                    color: #fff;
                }

        .toolbar-right {
            margin-left: auto;
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .search {
            position: relative;
        }

            .search i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: var(--muted);
                pointer-events: none;
            }

            .search input {
                border: 1px solid #DCE1ED;
                border-radius: 10px;
                padding: 8px 12px 8px 36px;
                font-size: .88rem;
                width: 260px;
                outline: none;
            }

                .search input:focus, .sort-select:focus {
                    border-color: var(--brand);
                    box-shadow: 0 0 0 3px var(--brand-soft);
                    outline: none;
                }

        .sort-select {
            border: 1px solid #DCE1ED;
            border-radius: 10px;
            padding: 8px 12px;
            font-size: .88rem;
            background: #fff;
            color: var(--ink);
        }

        .inbox-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

            .inbox-table th {
                font-size: .72rem;
                font-weight: 600;
                letter-spacing: .07em;
                text-transform: uppercase;
                color: var(--muted);
                padding: 13px 20px;
                border-bottom: 1px solid var(--line);
                background: #FAFBFE;
            }

            .inbox-table td {
                padding: 15px 20px;
                border-bottom: 1px solid #f1f2f7;
                vertical-align: middle;
                font-size: .88rem;
            }

            .inbox-table tbody tr {
                cursor: pointer;
                transition: background .15s;
            }

                .inbox-table tbody tr:hover {
                    background: #FAFAFF;
                }

                .inbox-table tbody tr:not(.unread) .s-name,
                .inbox-table tbody tr:not(.unread) .subj {
                    font-weight: 500;
                }

        .sender {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            display: grid;
            place-items: center;
            font-weight: 600;
            font-size: .88rem;
            flex-shrink: 0;
        }

            .avatar.blue {
                background: #eff6ff;
                color: #2563eb;
            }

            .avatar.violet {
                background: #f5f3ff;
                color: #7c3aed;
            }

            .avatar.amber {
                background: #fffbeb;
                color: #d97706;
            }

            .avatar.rose {
                background: #fff1f2;
                color: #e11d48;
            }

            .avatar.teal {
                background: #f0fdfa;
                color: #0d9488;
            }

            .avatar.indigo {
                background: var(--brand-soft);
                color: var(--brand);
            }

            .avatar.lg {
                width: 52px;
                height: 52px;
                font-size: 1.05rem;
                border-radius: 14px;
                background: var(--brand);
                color: #fff;
            }

        .s-name {
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .s-mail {
            color: var(--muted);
            font-size: .8rem;
        }

        .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--brand);
            display: inline-block;
        }

        .subj {
            font-weight: 700;
        }

        .preview {
            color: var(--muted);
            font-size: .8rem;
            max-width: 460px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .date {
            color: var(--muted);
            font-size: .8rem;
            white-space: nowrap;
        }

        .actions {
            display: flex;
            gap: 6px;
            justify-content: flex-end;
        }

        .icon-btn {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            border: 1px solid var(--line);
            background: #fff;
            display: grid;
            place-items: center;
            color: var(--muted);
            text-decoration: none;
            transition: .15s;
            padding: 0;
        }

            .icon-btn:hover {
                border-color: var(--brand);
                color: var(--brand);
            }

            .icon-btn.danger {
                color: var(--danger);
                border-color: #f5c6c2;
            }

                .icon-btn.danger:hover {
                    background: #fdf0ef;
                }

        .table-foot {
            padding: 14px 20px;
            font-size: .8rem;
            color: var(--muted);
        }

        .empty {
            padding: 48px 20px;
            text-align: center;
            color: var(--muted);
        }

        .msg-modal .modal-content {
            border: 0;
            border-radius: 18px;
            overflow: hidden;
        }

        .msg-modal .modal-header {
            padding: 18px 26px;
            border-bottom: 1px solid var(--line);
            gap: 10px;
        }

        .mp-badge {
            font-size: .7rem;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            padding: 5px 10px;
            border-radius: 8px;
        }

            .mp-badge.unread {
                background: var(--brand-soft);
                color: var(--brand);
            }

            .mp-badge.read {
                background: #ecfdf5;
                color: #059669;
            }

        .mp-ref {
            color: var(--muted);
            font-size: .8rem;
        }

        .msg-modal .modal-body {
            padding: 22px 26px;
        }

        .mp-sender {
            display: flex;
            gap: 14px;
            align-items: center;
            margin-bottom: 22px;
        }

        .mp-name {
            font-weight: 700;
            font-size: 1rem;
        }

        .mp-mail {
            color: var(--brand);
            font-size: .85rem;
        }

        .mp-date {
            color: var(--muted);
            font-size: .78rem;
            margin-left: auto;
            align-self: flex-start;
            white-space: nowrap;
        }

        .mp-label {
            font-size: .72rem;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--muted);
            margin-bottom: 6px;
        }

        .mp-subject {
            font-size: 1.2rem;
            font-weight: 600;
            margin: 0 0 16px;
        }

        .mp-text {
            background: #FAFBFE;
            border: 1px solid var(--line);
            border-radius: 14px;
            padding: 18px;
            font-size: .9rem;
            line-height: 1.7;
            white-space: pre-line;
            max-height: 340px;
            overflow: auto;
        }

        .msg-modal .modal-footer {
            padding: 14px 26px;
            border-top: 1px solid var(--line);
            background: #FAFBFE;
        }

        .btn-accent {
            background: var(--brand);
            border: 1px solid var(--brand);
            color: #fff;
            border-radius: 12px;
            font-weight: 600;
            padding: 9px 20px;
            box-shadow: 0 4px 12px rgba(130, 118, 217, .25);
        }

            .btn-accent:hover {
                background: var(--brand-hover);
                color: #fff;
            }

        .btn-soft {
            background: #fff;
            border: 1px solid var(--line);
            color: var(--ink);
            border-radius: 12px;
            font-weight: 500;
            padding: 9px 18px;
        }

            .btn-soft:hover {
                background: #F8F9FD;
                color: var(--brand);
            }

        .btn-soft-danger {
            background: #fff;
            border: 1px solid #f5c6c2;
            color: var(--danger);
            border-radius: 12px;
            font-weight: 500;
            padding: 9px 18px;
        }

            .btn-soft-danger:hover {
                background: #fdf0ef;
                color: var(--danger);
            }

        @@media (max-width: 900px) {
            .inbox-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .col-preview, .col-date {
                display: none;
            }

            .toolbar-right {
                margin-left: 0;
                width: 100%;
            }

            .search {
                flex: 1;
            }

                .search input {
                    width: 100%;
                }
        }
    </style>
}

<div class="inbox">

    <div class="inbox-head">
    
        <a asp-area="Admin" asp-controller="Message" asp-action="CreateMessage" class="btn btn-accent">
            <i class="bi bi-plus-lg me-1"></i> New Message
        </a>
    </div>
    <div class="inbox-stats">
        <div class="stat">
            <div>
                <div class="stat-label">Total Received</div>
                <div class="stat-value">@total</div>
                <div class="stat-sub">All time messages</div>
            </div>
            <div class="stat-icon"><i class="bi bi-inbox"></i></div>
        </div>
        <div class="stat active">
            <div>
                <div class="stat-label">Unread Inquiries</div>
                <div class="stat-value" id="unreadStat">@unread</div>
                <div class="stat-sub warn" id="unreadSub">@(unread > 0 ? "Action required" : "All caught up")</div>
            </div>
            <div class="stat-icon"><i class="bi bi-envelope-exclamation"></i></div>
        </div>
        <div class="stat">
            <div>
                <div class="stat-label">Received Today</div>
                <div class="stat-value">@today</div>
                <div class="stat-sub">@DateTime.Today.ToString("dd MMM yyyy")</div>
            </div>
            <div class="stat-icon green"><i class="bi bi-calendar-check"></i></div>
        </div>
        <div class="stat">
            <div>
                <div class="stat-label">Last 7 Days</div>
                <div class="stat-value">@thisWeek</div>
                <div class="stat-sub">Weekly volume</div>
            </div>
            <div class="stat-icon gray"><i class="bi bi-graph-up"></i></div>
        </div>
    </div>

    <div class="inbox-card">
        <div class="toolbar">
            <button type="button" class="tab active" data-filter="all">All Inquiries <span class="count">@total</span></button>
            <button type="button" class="tab" data-filter="unread">Unread <span class="count" id="unreadTab">@unread</span></button>
            <div class="toolbar-right">
                <div class="search">
                    <i class="bi bi-search"></i>
                    <input id="inboxSearch" type="text" placeholder="Search by sender or subject..." />
                </div>
                <select id="sortSelect" class="sort-select" title="Sort by date">
                    <option value="desc">Newest first</option>
                    <option value="asc">Oldest first</option>
                </select>
            </div>
        </div>

        <table class="inbox-table">
            <thead>
                <tr>
                    <th>Sender Details</th>
                    <th class="col-preview">Subject &amp; Message Preview</th>
                    <th class="col-date">Date</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody id="inboxBody">
                @{
                    var i = 0;
                }
                @foreach (var item in Model)
                {
                    var color = palette[i++ % palette.Length];
                    <tr class="@(item.IsRead ? "" : "unread")"
                        data-id="@item.MessageId"
                        data-name="@item.NameSurname"
                        data-email="@item.Email"
                        data-subject="@item.Subject"
                        data-body="@item.MessageDetail"
                        data-date="@item.SendDate.ToString("dd MMM yyyy, HH:mm")"
                        data-sort="@item.SendDate.ToString("yyyyMMddHHmmss")"
                        data-initials="@Initials(item.NameSurname)"
                        data-read="@(item.IsRead ? "1" : "0")">
                        <td>
                            <div class="sender">
                                <div class="avatar @color">@Initials(item.NameSurname)</div>
                                <div>
                                    <div class="s-name">
                                        @item.NameSurname
                                        @if (!item.IsRead)
                                        {
                                            <span class="dot" title="Unread"></span>
                                        }
                                    </div>
                                    <div class="s-mail">@item.Email</div>
                                </div>
                            </div>
                        </td>
                        <td class="col-preview">
                            <div class="subj">@item.Subject</div>
                            <div class="preview">@item.MessageDetail</div>
                        </td>
                        <td class="col-date"><span class="date">@item.SendDate.ToString("dd MMM yyyy")</span></td>
                        <td>
                            <div class="actions">
                                <button type="button" class="icon-btn" title="Read message"><i class="bi bi-eye"></i></button>
                                <a asp-area="Admin" asp-controller="Message" asp-action="DeleteMessage" asp-route-id="@item.MessageId"
                                   class="icon-btn danger js-delete" title="Delete"><i class="bi bi-trash3"></i></a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <div class="empty"><i class="bi bi-inbox fs-2 d-block mb-2"></i>No messages yet.</div>
        }
        <div class="table-foot">Showing <b id="visibleCount">@total</b> of <b>@total</b> entries</div>
    </div>

    <!-- Bootstrap Modal: Mesaj detayı (sadece okuma) -->
    <div class="modal fade msg-modal" id="messageModal" tabindex="-1" aria-labelledby="mSubject" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <span class="mp-badge" id="mBadge"></span>
                    <span class="mp-ref" id="mRef"></span>
                    <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mp-sender">
                        <div class="avatar lg" id="mInitials"></div>
                        <div>
                            <div class="mp-name" id="mName"></div>
                            <div class="mp-mail" id="mMail"></div>
                        </div>
                        <div class="mp-date"><i class="bi bi-clock me-1"></i><span id="mDate"></span></div>
                    </div>
                    <div class="mp-label">Subject</div>
                    <h5 class="mp-subject" id="mSubject"></h5>
                    <div class="mp-text" id="mBody"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-soft-danger me-auto" id="mDelete">
                        <i class="bi bi-trash3 me-1"></i> Delete
                    </button>
                    <button type="button" class="btn btn-soft" data-bs-dismiss="modal">Close</button>
                    <a class="btn btn-accent" id="mReply" href="#"><i class="bi bi-reply me-1"></i> Reply</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.14.5/dist/sweetalert2.all.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const tbody = document.getElementById('inboxBody');
        const rows = Array.from(tbody.querySelectorAll('tr'));
        const $ = id => document.getElementById(id);
        const modalEl = $('messageModal');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        let unreadCount = @unread;
        let filter = 'all';
        let currentRow = null;

        // Silme onayı (SweetAlert2)
        function confirmDelete(url) {
            Swal.fire({
                title: 'Delete this message?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: '<i class="bi bi-trash3 me-1"></i> Yes, delete it',
                cancelButtonText: 'Cancel',
                confirmButtonColor: '#c0342b',
                cancelButtonColor: '#94a3b8',
                reverseButtons: true,
                focusCancel: true
            }).then(r => { if (r.isConfirmed) window.location.href = url; });
        }

        // Okundu yap: sadece IsRead değişir, içerik değişmez
        function markRead(row) {
            fetch('/Admin/Message/MarkAsRead/' + row.dataset.id, { method: 'POST' })
                .then(res => {
                    if (!res.ok) return;
                    row.dataset.read = '1';
                    row.classList.remove('unread');
                    row.querySelector('.dot')?.remove();
                    unreadCount = Math.max(0, unreadCount - 1);
                    $('unreadStat').textContent = unreadCount;
                    $('unreadTab').textContent = unreadCount;
                    $('unreadSub').textContent = unreadCount > 0 ? 'Action required' : 'All caught up';
                    if (filter === 'unread') apply();
                });
        }

        // Modal'ı doldur ve aç
        function openMessage(row) {
            const d = row.dataset;
            const wasUnread = d.read === '0';
            currentRow = row;

            $('mBadge').textContent = wasUnread ? 'New' : 'Read';
            $('mBadge').className = 'mp-badge ' + (wasUnread ? 'unread' : 'read');
            $('mRef').textContent = 'Inquiry #' + d.id;
            $('mInitials').textContent = d.initials;
            $('mName').textContent = d.name;
            $('mMail').textContent = d.email;
            $('mDate').textContent = d.date;
            $('mSubject').textContent = d.subject;
            $('mBody').textContent = d.body;
            $('mReply').href = '/Admin/Message/CreateMessage?email=' + encodeURIComponent(d.email)
                             + '&subject=' + encodeURIComponent('Re: ' + d.subject);

            modal.show();
            if (wasUnread) markRead(row);
        }

        rows.forEach(row => row.addEventListener('click', e => {
            if (e.target.closest('.js-delete')) return;
            openMessage(row);
        }));

        // Modal içindeki Delete: önce modal kapanır, sonra onay açılır
        $('mDelete').addEventListener('click', () => {
            const url = currentRow.querySelector('.js-delete').href;
            modalEl.addEventListener('hidden.bs.modal', () => confirmDelete(url), { once: true });
            modal.hide();
        });

        // Tablodaki çöp kutusu
        document.querySelectorAll('.js-delete').forEach(a => a.addEventListener('click', e => {
            e.preventDefault();
            e.stopPropagation();
            confirmDelete(a.href);
        }));

        // Filtre + arama
        function apply() {
            const q = $('inboxSearch').value.toLowerCase().trim();
            let visible = 0;
            rows.forEach(row => {
                const d = row.dataset;
                const text = (d.name + ' ' + d.email + ' ' + d.subject).toLowerCase();
                const show = (filter === 'all' || d.read === '0') && (!q || text.includes(q));
                row.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            $('visibleCount').textContent = visible;
        }
        document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', () => {
            document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
            t.classList.add('active');
            filter = t.dataset.filter;
            apply();
        }));
        $('inboxSearch').addEventListener('input', apply);

        // Tarihe göre sıralama
        $('sortSelect').addEventListener('change', e => {
            const dir = e.target.value === 'asc' ? 1 : -1;
            rows.sort((a, b) => a.dataset.sort.localeCompare(b.dataset.sort) * dir)
                .forEach(r => tbody.appendChild(r));
        });

        // Silme sonrası bildirim
        const flash = @Json.Serialize(TempData["Success"]);
        if (flash) {
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: flash,
                        showConfirmButton: false, timer: 2500, timerProgressBar: true });
        }
    });
</script>