@model List<MYAcademy_PortfolioProject.Entities.Message>

@{
    ViewData["Title"] = "MessageList";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";
}

<div class="container">
    <br />
    <table class="table table-bordered">
        <tr>
            <th>#</th>
            <th>Görsel</th>
            <th>Email</th>
            <th>Konu</th>
            <th>Tarih</th>
            <th>Mesaj Aç</th>
            <th>Sil</th>
        </tr>
        @foreach (var item in Model)
     {
      <tr>
        <td>@item.MessageId</td>
        <td>@item.NameSurname</td>
        <td>@item.Email</td>
        <td>@item.Subject</td>
        <td>@item.SendDate.ToString("dd MMM yyyy")</td>
        <td><a href="/Admin/Message/MessageDetail/@item.MessageId" class="btn btn-primary">Mesajı Aç</a></td>
        <td><a href="/Admin/Message/DeleteMessage/@item.MessageId" class="btn btn-danger">Sil</a></td>
       </tr>
   }
    </table>
</div>