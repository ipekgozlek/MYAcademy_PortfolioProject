@model Experience
@{
    ViewData["Title"] = "Edit Experience";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";

    var workTypes = new List<string> { "Full-time", "Part-time", "Internship", "Freelance", "Remote", "Hybrid" };
    // Keep an older saved value selectable even if it is not in the list
    if (!string.IsNullOrWhiteSpace(Model?.WorkType) && !workTypes.Contains(Model.WorkType))
    {
        workTypes.Insert(0, Model.WorkType);
    }
}

<div class="form-card">
    <form asp-area="Admin" asp-controller="Experience" asp-action="UpdateExperience" method="post">
        <input type="hidden" asp-for="ExperienceId" />

        <div class="form-card-header">
            <div class="form-card-icon"><i class="bi bi-briefcase"></i></div>
            <div>
                <h5 class="mb-0 fw-bold">Edit Experience</h5>
                <small class="text-secondary">Update the position details on your work timeline.</small>
            </div>
        </div>

        <div class="form-card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Title" class="form-label">Position <span class="req">*</span></label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. Software Engineer" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="CompanyName" class="form-label">Company <span class="req">*</span></label>
                    <input asp-for="CompanyName" class="form-control" placeholder="e.g. NovaTech Solutions" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="Duration" class="form-label">Date Range <span class="req">*</span></label>
                    <input asp-for="Duration" class="form-control" placeholder="e.g. 2024 – Present" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="WorkType" class="form-label">Work Type <span class="req">*</span></label>
                    <select asp-for="WorkType" class="form-select" required>
                        <option value="">Select...</option>
                        @foreach (var t in workTypes)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="SideTitle" class="form-label">Side Note</label>
                    <input asp-for="SideTitle" class="form-control" placeholder="e.g. Enterprise Web Solutions" />
                    <small class="text-secondary">Shown in italics next to the card on the timeline.</small>
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label">Description <span class="req">*</span></label>
                    <textarea asp-for="Description" class="form-control" rows="5" required></textarea>
                    <small class="text-secondary">Write each responsibility on a new line; they appear as bullet points on the website.</small>
                </div>
                <div class="col-12">
                    <div class="status-box">
                        <div>
                            <div class="fw-semibold" style="font-size:.86rem;">Publish on website</div>
                            <small class="text-secondary">Passive records are hidden on the homepage.</small>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-card-footer">
            <a asp-area="Admin" asp-controller="Experience" asp-action="ExperienceList" class="btn btn-soft">
                <i class="bi bi-arrow-left me-1"></i> Cancel
            </a>
            <button type="submit" class="btn btn-accent"><i class="bi bi-check2-circle me-1"></i> Save Changes</button>
        </div>
    </form>
</div>
