@model MYAcademy_PortfolioProject.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/_AdminLayout.cshtml";

    var stats = new[]
    {
        (Label: "Total Projects", Value: Model.TotalProjects,   Icon: "bi-grid",               Color: "c-purple", Sub: $"{Model.ActiveProjects} active"),
        (Label: "Active Projects",Value: Model.ActiveProjects,  Icon: "bi-check2-circle",      Color: "c-green",  Sub: "Visible on website"),
        (Label: "Skills",         Value: Model.SkillCount,      Icon: "bi-code-slash",         Color: "c-blue",   Sub: "Across all categories"),
        (Label: "Experiences",    Value: Model.ExperienceCount, Icon: "bi-briefcase",          Color: "c-amber",  Sub: "Work history"),
        (Label: "Education",      Value: Model.EducationCount,  Icon: "bi-mortarboard",        Color: "c-teal",   Sub: "Schools & degrees"),
        (Label: "Total Messages", Value: Model.TotalMessages,   Icon: "bi-envelope",           Color: "c-purple", Sub: "All time"),
        (Label: "Unread Messages",Value: Model.UnreadMessages,  Icon: "bi-envelope-exclamation",Color: "c-rose",  Sub: Model.UnreadMessages > 0 ? "Action required" : "All caught up")
    };

    var maxCount = Model.CategorySummaries.Any() ? Model.CategorySummaries.Max(x => x.ProjectCount) : 1;

    string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var p = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return (p[0][..1] + (p.Length > 1 ? p[^1][..1] : "")).ToUpper();
    }
}

@section Styles {
    <style>
        .dash-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .dash-stat {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-subtle);
            padding: 18px 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .dash-stat .label {
                font-size: .7rem;
                font-weight: 600;
                letter-spacing: .08em;
                text-transform: uppercase;
                color: var(--text-secondary);
            }

            .dash-stat .value {
                font-size: 1.8rem;
                font-weight: 700;
                line-height: 1.2;
                margin: 4px 0 2px;
            }

            .dash-stat .sub {
                font-size: .75rem;
                color: var(--text-secondary);
            }

        .dash-icon {
            width: 46px;
            height: 46px;
            border-radius: 13px;
            display: grid;
            place-items: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .c-purple {
            background: var(--pastel-purple);
            color: var(--primary-accent);
        }

        .c-green {
            background: #ecfdf5;
            color: #059669;
        }

        .c-blue {
            background: #eff6ff;
            color: #2563eb;
        }

        .c-amber {
            background: #fffbeb;
            color: #d97706;
        }

        .c-teal {
            background: #f0fdfa;
            color: #0d9488;
        }

        .c-rose {
            background: #fff1f2;
            color: #e11d48;
        }

        .dash-row {
            display: grid;
            grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
            gap: 20px;
            margin-bottom: 20px;
        }

        .dash-card-body {
            padding: 8px 24px 20px;
        }

        .msg-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid #f1f2f7;
            text-decoration: none;
            color: inherit;
        }

            .msg-item:last-child {
                border-bottom: 0;
            }

            .msg-item:hover {
                background: #FAFAFF;
            }

        .msg-avatar {
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: grid;
            place-items: center;
            font-weight: 600;
            font-size: .82rem;
            background: var(--pastel-purple);
            color: var(--primary-accent);
            flex-shrink: 0;
        }

        .msg-item.unread .msg-name {
            font-weight: 700;
        }

        .msg-name {
            font-weight: 500;
            font-size: .88rem;
        }

        .msg-subject {
            color: var(--text-secondary);
            font-size: .8rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .msg-meta {
            margin-left: auto;
            text-align: right;
            flex-shrink: 0;
            font-size: .75rem;
            color: var(--text-secondary);
        }

        .unread-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--primary-accent);
            display: inline-block;
        }

        .cat-row {
            margin-bottom: 14px;
        }

            .cat-row:last-child {
                margin-bottom: 0;
            }

        .cat-bar {
            height: 8px;
            border-radius: 99px;
            background: #F1F2F7;
            overflow: hidden;
            margin-top: 6px;
        }

            .cat-bar > div {
                height: 100%;
                border-radius: 99px;
                background: linear-gradient(90deg, var(--primary-accent), #A99BF5);
            }

        .quick-btn {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            text-decoration: none;
            color: var(--text-primary);
            margin-bottom: 10px;
            transition: .15s;
        }

            .quick-btn:last-child {
                margin-bottom: 0;
            }

            .quick-btn:hover {
                border-color: var(--primary-accent);
                color: var(--primary-accent);
                background: #FAFAFF;
            }

            .quick-btn .dash-icon {
                width: 38px;
                height: 38px;
                font-size: 1.05rem;
                border-radius: 11px;
            }

        @@media (max-width: 992px) {
            .dash-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<!-- ===== İstatistik kartları ===== -->
<div class="dash-stats">
    @foreach (var s in stats)
    {
        <div class="dash-stat">
            <div>
                <div class="label">@s.Label</div>
                <div class="value">@s.Value</div>
                <div class="sub">@s.Sub</div>
            </div>
            <div class="dash-icon @s.Color"><i class="bi @s.Icon"></i></div>
        </div>
    }
</div>

<div class="dash-row">
    <!-- ===== Son 5 mesaj ===== -->
    <div class="list-card">
        <div class="list-card-header">
            <h6 class="mb-0 fw-bold"><i class="bi bi-envelope me-2"></i>Latest Messages</h6>
            <a asp-area="Admin" asp-controller="Message" asp-action="MessageList" class="small text-decoration-none">View all →</a>
        </div>
        <div class="dash-card-body">
            @foreach (var m in Model.LastMessages)
            {
                <a href="/Admin/Message/MessageList?open=@m.MessageId" class="msg-item @(m.IsRead ? "" : "unread")">
                    <div class="msg-avatar">@Initials(m.NameSurname)</div>
                    <div style="min-width:0;">
                        <div class="msg-name">@m.NameSurname</div>
                        <div class="msg-subject">@m.Subject</div>
                    </div>
                    <div class="msg-meta">
                        <div>@m.SendDate.ToString("dd MMM, HH:mm")</div>
                        @if (!m.IsRead)
                        {
                            <span class="unread-dot" title="Unread"></span>
                        }
                        else
                        {
                            <i class="bi bi-check2-all" title="Read"></i>
                        }
                    </div>
                </a>
            }
            @if (!Model.LastMessages.Any())
            {
                <div class="empty-state"><i class="bi bi-inbox"></i>No messages yet.</div>
            }
        </div>
    </div>

    <!-- ===== Hızlı işlemler ===== -->
    <div class="list-card">
        <div class="list-card-header">
            <h6 class="mb-0 fw-bold"><i class="bi bi-lightning-charge me-2"></i>Quick Actions</h6>
        </div>
        <div class="dash-card-body pt-3">
            <a asp-area="Admin" asp-controller="Project" asp-action="CreateProject" class="quick-btn">
                <div class="dash-icon c-purple"><i class="bi bi-plus-lg"></i></div>
                <div><div class="fw-semibold">New Project</div><small class="text-secondary">Add a project to your portfolio</small></div>
            </a>
            <a asp-area="Admin" asp-controller="Message" asp-action="MessageList" class="quick-btn">
                <div class="dash-icon c-rose"><i class="bi bi-envelope-open"></i></div>
                <div><div class="fw-semibold">View Messages</div><small class="text-secondary">@Model.UnreadMessages unread</small></div>
            </a>
            <a href="/Default/Index" target="_blank" class="quick-btn">
                <div class="dash-icon c-green"><i class="bi bi-box-arrow-up-right"></i></div>
                <div><div class="fw-semibold">Open Portfolio</div><small class="text-secondary">See your live website</small></div>
            </a>
        </div>
    </div>
</div>

<div class="dash-row">
    <!-- ===== Son 3 proje ===== -->
    <div class="list-card">
        <div class="list-card-header">
            <h6 class="mb-0 fw-bold"><i class="bi bi-grid me-2"></i>Latest Projects</h6>
            <a asp-area="Admin" asp-controller="Project" asp-action="ProjectList" class="small text-decoration-none">View all →</a>
        </div>
        <table class="list-table">
            <thead>
                <tr><th>Project</th><th>Category</th><th>Status</th><th class="text-end">Edit</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model.LastProjects)
                {
                    <tr>
                        <td class="cell-title">@p.Title</td>
                        <td><span class="type-chip">@p.Category?.CategoryName</span></td>
                        <td><span class="status-pill @(p.IsActive ? "on" : "off")">@(p.IsActive ? "Active" : "Passive")</span></td>
                        <td class="text-end">
                            <a asp-area="Admin" asp-controller="Project" asp-action="UpdateProject" asp-route-id="@p.ProjectId"
                               class="icon-btn" title="Edit"><i class="bi bi-pencil"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.LastProjects.Any())
        {
            <div class="empty-state"><i class="bi bi-grid"></i>No projects yet.</div>
        }
    </div>

    <!-- ===== Kategori özeti ===== -->
    <div class="list-card">
        <div class="list-card-header">
            <h6 class="mb-0 fw-bold"><i class="bi bi-bar-chart me-2"></i>Projects by Category</h6>
        </div>
        <div class="dash-card-body pt-3">
            @foreach (var c in Model.CategorySummaries)
            {
                <div class="cat-row">
                    <div class="d-flex justify-content-between small">
                        <span class="fw-semibold">@c.CategoryName</span>
                        <span class="text-secondary">@c.ProjectCount</span>
                    </div>
                    <div class="cat-bar"><div style="width:@(c.ProjectCount * 100 / maxCount)%"></div></div>
                </div>
            }
            @if (!Model.CategorySummaries.Any())
            {
                <div class="empty-state"><i class="bi bi-bar-chart"></i>No data yet.</div>
            }
        </div>
    </div>
</div>