@model List<Certificate>
@{
    var icons = new[] { "bi-patch-check", "bi-award", "bi-code-square", "bi-window", "bi-database-check", "bi-diagram-3" };
    var colors = new[] { "bg-icon-purple", "bg-icon-blue", "bg-icon-mint", "bg-icon-peach" };
}

<section id="certificates" style="background-color: var(--bg-secondary);">
    <div class="container">
        <div class="text-center mb-5 reveal-on-scroll">
            <span class="section-eyebrow">CONTINUOUS LEARNING</span>
            <h2 class="section-title">Certificates</h2>
            <p class="section-subtitle">Certifications and training that keep my skills up to date.</p>
        </div>

        <div class="row g-4">
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                <div class="col-lg-4 col-md-6 reveal-on-scroll">
                    <div class="certificate-card">
                        <div class="float-icon-box @colors[i % colors.Length] mb-3">
                            <i class="bi @icons[i % icons.Length]"></i>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.DateText))
                        {
                            <span class="badge bg-light text-secondary border rounded-pill px-2 py-1 mb-2 align-self-start small">@item.DateText</span>
                        }
                        <h4 class="fs-6 fw-bold mb-1">@item.Title</h4>
                        <div class="text-secondary small mb-3">@item.Issuer</div>
                        @if (!string.IsNullOrWhiteSpace(item.CertificateUrl))
                        {
                            <div class="mt-auto">
                                <a href="@item.CertificateUrl" target="_blank" rel="noopener noreferrer" class="project-link-btn text-primary">
                                    View Certificate <i class="bi bi-arrow-up-right"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <p class="text-center text-secondary">No certificates added yet.</p>
            }
        </div>
    </div>
</section>
