@model MYAcademy_PortfolioProject.Entities.HeroSection
@{
    var image = string.IsNullOrWhiteSpace(Model?.ImageUrl)
        ? "https://placehold.co/600x750/EEF2FF/8276D9?text=Photo"
        : Model.ImageUrl;
}

@if (Model != null)
{
    <section id="home">
        <div class="container">
            <div class="row align-items-center g-5">
                <!-- Sol -->
                <div class="col-lg-7 reveal-on-scroll">
                    <div class="hero-badge">
                        <span>👋</span> @Model.SubTitle
                    </div>

                    <h1 class="hero-title">
                        Merhaba, Ben <span class="hero-name-gradient">@Model.Title</span>.
                    </h1>

                    <div class="typing-container" aria-live="polite">
                        <span id="typedText"></span><span class="typing-cursor"></span>
                    </div>

                    <p class="hero-desc">@Model.Description</p>

                    <div class="d-flex flex-wrap gap-3 align-items-center mb-4">
                        <a href="#projects" class="btn-custom-primary">
                            <i class="bi bi-grid-fill"></i> Projelerimi İncele
                        </a>
                        <a href="#contact" class="btn-custom-outline">
                            <i class="bi bi-chat-dots"></i> Benimle İletişime Geç
                        </a>
                    </div>

                    <!-- Sosyal linkler (bir sonraki adımda dinamik olacak) -->
                    <div class="d-flex align-items-center gap-2 pt-2">
                        <span class="text-secondary small fw-medium me-2">Bağlantılar:</span>
                        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub"><i class="bi bi-github"></i></a>
                        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="mailto:ornek@example.com" class="social-btn" aria-label="E-posta"><i class="bi bi-envelope"></i></a>
                    </div>
                </div>

                <!-- Sağ: Görsel -->
                <div class="col-lg-5 reveal-on-scroll">
                    <div class="hero-image-wrapper">
                        <div class="floating-card float-top-left">
                            <div class="float-icon-box bg-icon-purple"><i class="bi bi-code-slash"></i></div>
                            <div>
                                <div class="fw-bold small text-dark">Clean Code</div>
                                <div class="text-secondary" style="font-size: 0.72rem;">C# & ASP.NET Core</div>
                            </div>
                        </div>

                        <div class="hero-image-frame">
                            <img src="@image" alt="@Model.Title - @Model.SubTitle" loading="lazy">
                        </div>

                        <div class="floating-card float-bottom-right">
                            <div class="float-icon-box bg-icon-mint"><i class="bi bi-laptop"></i></div>
                            <div>
                                <div class="fw-bold small text-dark">@Model.SubTitle</div>
                                <div class="text-secondary" style="font-size: 0.72rem;">Full Stack Developer</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}