@model List<MYAcademy_PortfolioProject.Entities.Project>
@{
    // Sadece projesi olan kategoriler filtre butonu olsun
    var categories = Model.Where(x => x.Category != null)
                          .Select(x => x.Category)
                          .DistinctBy(c => c.CategoryId)
                          .ToList();
}

<section id="projects">
    <div class="container">
        <div class="text-center mb-4 reveal-on-scroll">
            <span class="section-eyebrow">SEÇİLMİŞ ÇALIŞMALAR</span>
            <h2 class="section-title">Projelerim</h2>
            <p class="section-subtitle">Öğrendiklerimi gerçek ürünlere dönüştürdüğüm çalışmalar.</p>
        </div>

        <!-- Filtre butonları: veritabanındaki kategorilerden -->
        <div class="d-flex justify-content-center flex-wrap gap-2 mb-5 reveal-on-scroll" id="projectFilterGroup">
            <button class="filter-btn active" data-filter="all">Tümü</button>
            @foreach (var c in categories)
            {
                <button class="filter-btn" data-filter="cat-@c.CategoryId">@c.CategoryName</button>
            }
        </div>

        <div class="row g-4" id="projectGrid">
            @foreach (var item in Model)
            {
                var techs = (item.Technologies ?? "")
                            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                <div class="col-lg-4 col-md-6 project-item" data-category="cat-@item.CategoryId">
                    <div class="project-card reveal-on-scroll">

                        <div class="project-thumb" style="width:100%; aspect-ratio:16/9; overflow:hidden;">
                             <img src="@(item.CoverImageUrl ?? "https://placehold.co/800x450/EEF2FF/8276D9?text=" + item.Title)" alt="@item.Title" loading="lazy"
                                 style="width:100%; height:100%; object-fit:cover; display:block;" />
                        </div>

                        <div class="project-body">
                            <span class="project-category-badge">@item.Category?.CategoryName</span>
                            <h3 class="project-title">@item.Title</h3>
                            <p class="project-desc">@item.Description</p>

                            @if (techs.Any())
                            {
                                <div class="mb-3">
                                    @foreach (var t in techs)
                                    {
                                        <span class="tech-tag">@t</span>
                                    }
                                </div>
                            }

                            <div class="project-footer">
                                @if (!string.IsNullOrWhiteSpace(item.GithubUrl))
                                {
                                    <a href="@item.GithubUrl" target="_blank" rel="noopener noreferrer" class="project-link-btn">
                                        <i class="bi bi-github"></i> GitHub
                                    </a>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.LiveUrl))
                                {
                                    <a href="@item.LiveUrl" target="_blank" rel="noopener noreferrer" class="project-link-btn text-primary">
                                        <i class="bi bi-box-arrow-up-right"></i> Canlı Demo
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (!Model.Any())
            {
                <p class="text-center text-secondary">Henüz proje eklenmemiş.</p>
            }
        </div>
    </div>
</section>