            <div class="row g-5">
                <!-- Left: Contact Details -->
                <div class="col-lg-5 reveal-on-scroll">
                    @await Component.InvokeAsync("_DefaultContactInfoComponentPartial")
                </div>

                   

                <!-- Right: Contact Form -->
                <div class="col-lg-7 reveal-on-scroll">
                    <div class="contact-form-card">
                        <form id="contactForm" asp-controller="Default" asp-action="SendMessage" method="post" novalidate>
                            @Html.AntiForgeryToken()

                            <div id="formSuccessMessage" class="alert alert-success border-0 rounded-3 small py-2 px-3 mb-4 d-none" role="alert">
                                <i class="bi bi-check-circle-fill me-2"></i> Mesajınız başarıyla iletildi! Teşekkür ederiz.
                            </div>
                            <div id="formErrorMessage" class="alert alert-danger border-0 rounded-3 small py-2 px-3 mb-4 d-none" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i> Mesaj gönderilemedi, lütfen tekrar deneyin.
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label for="contactFullName" class="form-label">Adınız Soyadınız *</label>
                                    <input type="text" class="form-control" id="contactFullName" name="NameSurname"
                                           placeholder="Örn: Seher Yılmaz" required minlength="2" maxlength="50">
                                    <div class="invalid-feedback" data-for="NameSurname">Ad soyad 2-50 karakter olmalıdır.</div>
                                </div>

                                <div class="col-md-6">
                                    <label for="contactEmail" class="form-label">E-posta Adresiniz *</label>
                                    <input type="email" class="form-control" id="contactEmail" name="Email"
                                           placeholder="Örn: seher@example.com" required maxlength="100">
                                    <div class="invalid-feedback" data-for="Email">Geçerli bir e-posta adresi giriniz.</div>
                                </div>

                                <div class="col-12">
                                    <label for="contactSubject" class="form-label">Konu *</label>
                                    <input type="text" class="form-control" id="contactSubject" name="Subject"
                                           placeholder="Örn: Proje İş Birliği veya Danışmanlık" required minlength="3" maxlength="100">
                                    <div class="invalid-feedback" data-for="Subject">Konu 3-100 karakter olmalıdır.</div>
                                </div>

                                <div class="col-12">
                                    <label for="contactMessage" class="form-label">Mesajınız *</label>
                                    <textarea class="form-control" id="contactMessage" name="MessageDetail" rows="5"
                                              placeholder="Projeniz veya paylaşmak istedikleriniz hakkında detay verebilirsiniz..."
                                              required minlength="10" maxlength="2000"></textarea>
                                    <div class="invalid-feedback" data-for="MessageDetail">Mesaj en az 10 karakter olmalıdır.</div>
                                </div>

                                <div class="col-12 mt-4">
                                    <button type="submit" id="contactSubmitBtn" class="btn-custom-primary w-100 justify-content-center py-3">
